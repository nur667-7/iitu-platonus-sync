# Platonus Credentials
PLATONUS_LOGIN=student_id@iitu.edu.kz
PLATONUS_PASSWORD=your_password_here

# Notion Integration
NOTION_TOKEN=ntn_your_notion_token_here
NOTION_UNIVERSITY_PAGE_ID=3ebd4221-a166-81ac-b96e-fba23c9b928c
NOTION_TASKS_DB_ID=3ebd4221-a166-813d-8c12-e4bed5dbda72
NOTION_INBOX_DB_ID=3ebd4221-a166-811f-bb50-d3d7110a377f
NOTION_KNOWLEDGE_DB_ID=3ebd4221-a166-81e0-97b3-f9a5c9e82a20

# Telegram Notifications & Serverless Webhook
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_WEBHOOK_SECRET=your_secret_token_here

# Local-only sensitive diagnostics. Keep false in Vercel and GitHub Actions.
DEBUG_SENSITIVE_LOGS=false

# Microsoft Teams Integration (Microsoft Graph API)
TEAMS_ENABLED=false
TEAMS_LOOKBACK_MINUTES=180
TEAMS_MAX_MESSAGES_PER_RUN=200
TEAMS_RETENTION_DAYS=30

# Teams Auth Option A: Direct Bearer Token
TEAMS_ACCESS_TOKEN=

# Teams Auth Option B: Azure AD / Microsoft Entra App Credentials
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=

# AI Semantic Classifier (Groq / OpenAI compatible)
GROQ_API_KEY=your_groq_api_key
AI_MODEL=openai/gpt-oss-120b
